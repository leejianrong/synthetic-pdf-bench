  "sections": [
    {
      "heading": "Chart Families",
      "blocks": [
        {
          "type": "paragraph",
          "text": "This section exercises chart extraction with deterministic raster charts generated from recipe data. The figures use Singapore, Malaysia, and Indonesia as labels while avoiding time-sensitive statistical claims.",
          "metadata": {"source_notes": ["Synthetic benchmark prose."]}
        },
        {
          "type": "figure",
          "figure_id": "fig_bar_chart",
          "kind": "bar_chart",
          "source_type": "raster",
          "title": "Synthetic Development Index",
          "caption": "Bar chart with country labels and deterministic illustrative values.",
          "data": {
            "backend": "matplotlib",
            "title": "Synthetic Development Index",
            "labels": ["Singapore", "Malaysia", "Indonesia"],
            "values": [94, 81, 76],
            "y_label": "Index"
          }
        },
        {
          "type": "figure",
          "figure_id": "fig_line_chart",
          "kind": "line_chart",
          "source_type": "raster",
          "title": "Illustrative Urbanization Trend",
          "caption": "Line chart with three country series across stable historical periods.",
          "data": {
            "backend": "matplotlib",
            "title": "Illustrative Urbanization Trend",
            "years": [1960, 1980, 2000, 2020],
            "series": {
              "Singapore": [45, 72, 88, 96],
              "Malaysia": [28, 44, 62, 78],
              "Indonesia": [18, 31, 46, 59]
            },
            "y_label": "Urbanization proxy"
          }
        },
        {
          "type": "figure",
          "figure_id": "fig_stacked_bar",
          "kind": "stacked_bar",
          "source_type": "raster",
          "title": "Illustrative Sector Composition",
          "caption": "Stacked bar chart showing deterministic qualitative sector composition.",
          "data": {
            "backend": "matplotlib",
            "title": "Illustrative Sector Composition",
            "labels": ["Singapore", "Malaysia", "Indonesia"],
            "series": {
              "Services": [65, 45, 40],
              "Manufacturing": [25, 35, 30],
              "Resources": [10, 20, 30]
            },
            "y_label": "Share"
          }
        },
        {
          "type": "figure",
          "figure_id": "fig_timeline_chart",
          "kind": "timeline",
