            "backend": "matplotlib",
            "title": "Synthetic City Cluster Scatter",
            "groups": ["Singapore", "Malaysia", "Indonesia"],
            "x_label": "Connectivity proxy",
            "y_label": "Urban services proxy"
          }
        },
        {
          "type": "figure",
          "figure_id": "fig_heatmap",
          "kind": "heatmap",
          "source_type": "raster",
